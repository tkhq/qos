hardened_usercopy=1 init_on_alloc=1 init_on_free=1 randomize_kstack_offset=on page_alloc.shuffle=1 slab_nomerge pti=on nosmt hash_pointers=always slub_debug=ZF iommu.passthrough=0 iommu.strict=1 proc_mem.force_override=never mitigations=auto,nosmt kfence.sample_interval=100 cfi=kcfi random.trust_cpu=on random.trust_bootloader=on
