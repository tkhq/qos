# Disables features the enclave does not use. The build fails if any come back.

# Networking. The enclave uses loopback, AF_UNIX, IPv4/IPv6 TCP and UDP
# sockets, rtnetlink (for `ip`), TUN for egress, and vsock. Pivots may bind
# IPv6 sockets, so IPv6 stays.
# CONFIG_PACKET is not set
# CONFIG_XFRM_USER is not set
# CONFIG_XFRM_SUB_POLICY is not set
# CONFIG_XFRM_MIGRATE is not set
# CONFIG_XFRM_STATISTICS is not set
# CONFIG_NET_KEY is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_PNP is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_TCP_MD5SIG is not set
# CONFIG_TCP_AO is not set
# CONFIG_MPTCP is not set
# CONFIG_IPV6_ROUTER_PREF is not set
# CONFIG_IPV6_OPTIMISTIC_DAD is not set
# CONFIG_INET6_AH is not set
# CONFIG_INET6_ESP is not set
# CONFIG_INET6_IPCOMP is not set
# CONFIG_IPV6_MIP6 is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_IPV6_MULTIPLE_TABLES is not set
# CONFIG_IPV6_MROUTE is not set
# CONFIG_IPV6_SEG6_LWTUNNEL is not set
# CONFIG_IPV6_SEG6_HMAC is not set
# CONFIG_IPV6_RPL_LWTUNNEL is not set
# CONFIG_IPV6_IOAM6_LWTUNNEL is not set
# CONFIG_NETLABEL is not set
# CONFIG_NETWORK_PHY_TIMESTAMPING is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_DCB is not set
# CONFIG_MPLS is not set
# CONFIG_NET_SWITCHDEV is not set
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_BPF_STREAM_PARSER is not set
# CONFIG_NET_PKTGEN is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_VETH is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_PTP_1588_CLOCK is not set

# Storage. The root filesystem is the initramfs; init mounts only devtmpfs,
# devpts, proc, sysfs, and tmpfs. No block device exists.
# CONFIG_BLOCK is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_QUOTA is not set
# CONFIG_FANOTIFY is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_CONFIGFS_FS is not set
# CONFIG_PSTORE is not set
# CONFIG_SWAP is not set
# CONFIG_ZSWAP is not set

# Devices. Nitro gives the enclave a serial console, vsock, and NSM over
# virtio-mmio. NITRO_ENCLAVES is the parent instance's driver for launching
# enclaves, not something an enclave uses.
# CONFIG_NITRO_ENCLAVES is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_SERIAL_DEV_BUS is not set
# CONFIG_VT is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_INPUT_FF_MEMLESS is not set
# CONFIG_HID is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_SYNC_FILE is not set
# CONFIG_STAGING is not set
# CONFIG_X86_CPUID is not set
# CONFIG_CONNECTOR is not set
# CONFIG_UEVENT_HELPER is not set

# Memory and kernel services with no enclave use. KSM merges identical pages
# across processes, which is a cross-process side channel.
# CONFIG_KSM is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_ARCH_MEMORY_PROBE is not set
# CONFIG_AUDIT is not set
# CONFIG_BSD_PROCESS_ACCT is not set
# CONFIG_TASKSTATS is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_PERCPU_STATS is not set
# CONFIG_SECURITY_NETWORK_XFRM is not set
# Keyrings (add_key, keyctl): nothing in the enclave uses them.
# CONFIG_KEYS is not set
