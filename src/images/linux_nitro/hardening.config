# KSPP common + x86_64 recommendations, reviewed against Linux 7.3.1 / Clang.
# Source and dispositions for inapplicable recommendations: docs/kernel_hardening.md.
CONFIG_BUG=y
CONFIG_DEBUG_KERNEL=y
CONFIG_EXPERT=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# CONFIG_DEVMEM is not set
CONFIG_PROC_MEM_NO_FORCE=y
CONFIG_SYN_COOKIES=y
CONFIG_LIST_HARDENED=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_VIRTUAL=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_LDISC_AUTOLOAD is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
# CONFIG_SECURITY_WRITABLE_HOOKS is not set
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
# No LSM that needs a policy: nothing in the enclave supplies one.
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,bpf"
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_TYPED=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_SLUB_DEBUG=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_VMAP_STACK=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_BOUNDS=y
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_SIGNED_WRAP is not set
# CONFIG_UBSAN_INTEGER_WRAP is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set
CONFIG_UBSAN_LOCAL_BOUNDS=y
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_WERROR=y
# Nitro uses the Linux boot protocol, with no EFI firmware or services.
# CONFIG_EFI is not set
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
# CONFIG_ACPI_CUSTOM_METHOD is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_DEVKMEM is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_INET_DIAG is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
# Hex bitmask: sync (0x10), remount read-only (0x20), reboot (0x80).
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0xb0
# CONFIG_MODULES is not set
# CONFIG_MODULE_FORCE_LOAD is not set
# NSM must be the only hwrng; see docs/randomness.md.
CONFIG_NSM=y
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_HW_RANDOM_VIA is not set
# CONFIG_TCG_TPM is not set
CONFIG_KSTACK_ERASE=y
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set
CONFIG_X86_64=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
# CONFIG_X86_MSR is not set
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# CONFIG_X86_VSYSCALL_EMULATION is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_X86_KERNEL_IBT=y
# CONFIG_COMPAT is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32 is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
CONFIG_MITIGATION_SLS=y
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
# CONFIG_COMPAT_VDSO is not set
# EXPERT=y flips these defaults off.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEBUG_MEMORY_INIT=y
# CONFIG_USER_NS is not set
# Unneeded production test and debug interfaces (keep integrity checks above).
# CONFIG_KUNIT is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
