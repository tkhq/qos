+	/// A transport adapter that records each request and response as JSON
+	/// Lines before delegating to another transport.
+	pub struct RecordingTransport<T> {
+		inner: T,
+		writer: Mutex<Box<dyn Write + Send>>,
+	}
+
+	impl<T> RecordingTransport<T> {
+		/// Append transcript records to `path`.
+		///
+		/// # Errors
+		///
+		/// Returns an error if the transcript file cannot be opened.
+		pub fn new(inner: T, path: impl AsRef<Path>) -> std::io::Result<Self> {
+			let file =
+				OpenOptions::new().create(true).append(true).open(path)?;
+
+			Ok(Self { inner, writer: Mutex::new(Box::new(file)) })
+		}
+
+		fn record(
+			&self,
+			endpoint: &Endpoint,
+			encoding: ProtocolMsgEncoding,
+			direction: &str,
+			payload: &ProtocolMsg,
+		) -> Result<(), String> {
+			let encoding = match encoding {
+				ProtocolMsgEncoding::Json => "json",
+				ProtocolMsgEncoding::Borsh => "borsh",
+			};
+			let mut writer = self.writer.lock().map_err(|error| {
+				format!("protocol transcript lock error: {error}")
+			})?;
+
+			serde_json::to_writer(
+				&mut *writer,
+				&serde_json::json!({
+					"endpoint": endpoint.as_str(),
+					"encoding": encoding,
+					"direction": direction,
+					"payload": payload,
+				}),
+			)
+			.map_err(|error| {
+				format!("protocol transcript serialization error: {error}")
+			})?;
+			writer.write_all(b"\n").map_err(|error| {
+				format!("protocol transcript write error: {error}")
+			})
+		}
+	}
+
+	impl<T: ProtocolTransport> ProtocolTransport for RecordingTransport<T> {
+		fn send(
+			&self,
+			endpoint: &Endpoint,
+			msg: &ProtocolMsg,
+			encoding: ProtocolMsgEncoding,
+		) -> Result<ProtocolMsg, String> {
+			self.record(endpoint, encoding, "request", msg)?;
+
+			let response = self.inner.send(endpoint, msg, encoding)?;
+
+			self.record(endpoint, encoding, "response", &response)?;
+
+			Ok(response)
+		}
+	}
+
